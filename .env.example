# Perfil do assistente
ASSISTANT_PROFILE=clinical_pharmacist_interviewer
SENIORITY_LEVEL=junior

# Presets rapidos de perfil (descomente e ajuste quando necessario)
# 1) Medical
# ASSISTANT_PROFILE=medical
# SENIORITY_LEVEL=
#
# 2) Entrevistador Farmaceutico Clinico
# ASSISTANT_PROFILE=clinical_pharmacist_interviewer
# SENIORITY_LEVEL=junior
#
# 3) Entrevistador Enfermagem Clinica
# ASSISTANT_PROFILE=clinical_nurse_interviewer
# SENIORITY_LEVEL=junior
#
# 4) Entrevistador Geral
# ASSISTANT_PROFILE=general_interviewer
# SENIORITY_LEVEL=junior

# Idioma
LANG=pt-BR

# Provedores
STT_PROVIDER=local
LLM_PROVIDER=api

# Credenciais (preencher localmente)
LLM_API_KEY=

# Contexto de conversa
MAX_CONTEXT_MESSAGES=12

# STT (defaults operacionais)
STT_CONFIDENCE_THRESHOLD=0.80
STT_MAX_RETRIES_BELOW_THRESHOLD=2
STT_P95_MAX_SECONDS=2.5

# SLO ponta a ponta
E2E_P95_MAX_SECONDS=4.0

# Fluxo de entrevista
MAX_QUESTIONS_PER_CYCLE=3
