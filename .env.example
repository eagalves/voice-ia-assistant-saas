# ==========================================
# Assistente de Voz - Exemplo de configuracao
# ==========================================
# Este arquivo mostra todas as configuracoes conhecidas.
# Copie para .env e ajuste os valores para seu ambiente.
#
# Presets de latencia predefinidos (baixa_latencia / balanceado / qualidade):
#   docs/latency_presets.md

# Define qual perfil de dominio sera carregado no bootstrap.
ASSISTANT_PROFILE=medical

# Define senioridade para perfis interviewer (junior|pleno|senior).
SENIORITY_LEVEL=junior

# Define o modo do perfil medical (consultation|doctor_followup).
MEDICAL_SESSION_MODE=consultation

# Define idioma geral do app (informativo para operacao/UI).
LANG=pt-BR

# Define o provider principal do LLM (openai|gemini|ollama).
LLM_PROVIDER=ollama

# Define numero de retries globais na chamada de LLM (apenas para LLM_ERR_UNAVAILABLE).
LLM_RETRIES=2

# Intervalo base (segundos) do backoff exponencial entre retries de LLM.
# Retry 1 aguarda ~base, retry 2 ~2x base, retry 3 ~4x base, etc.
LLM_RETRY_BACKOFF_BASE_S=1.0

# Cap maximo (segundos) de espera entre retries de LLM.
# O cap e aplicado apos o jitter: nenhum sleep excede este valor.
LLM_RETRY_BACKOFF_MAX_S=10.0

# Habilita fallback do provider principal para um secundario (0|1).
LLM_FALLBACK_ENABLED=1

# Define provider de fallback (openai|gemini|ollama).
LLM_FALLBACK_PROVIDER=gemini

# Exibe aviso explicito quando fallback ocorrer (0|1).
LLM_NOTIFY_FALLBACK=1

# Define ambiente de execucao para controlar notificacoes (dev|production).
APP_ENV=dev

# Chave da API OpenAI (obrigatoria se openai for primario ou fallback).
LLM_API_KEY=

# Chave da API Gemini (obrigatoria se gemini for primario ou fallback).
GEMINI_API_KEY=

# Modelo usado quando provider principal/fallback for OpenAI.
OPENAI_MODEL=gpt-4o

# Modelo usado quando provider principal/fallback for Gemini.
GEMINI_MODEL=gemini-2.0-flash

# Modelo usado quando provider principal/fallback for Ollama.
OLLAMA_MODEL=qwen2.5:3b

# Endpoint HTTP base do servidor Ollama local.
OLLAMA_BASE_URL=http://localhost:11434

# Timeout (segundos) para chamadas HTTP ao Ollama.
OLLAMA_TIMEOUT_S=30

# Define provider STT (mantido por compatibilidade de configuracao).
STT_PROVIDER=local

# Define idioma usado no STT e no fluxo de live caption.
STT_LANGUAGE=pt

# Define limiar de confianca do STT para aceitar transcricao automaticamente.
STT_CONFIDENCE=0.55

# Define numero maximo de retries do STT abaixo do limiar.
STT_MAX_RETRIES=1

# Modelo padrao Whisper usado como base para final/partial quando nao sobrescrito.
WHISPER_MODEL=small

# Modelo Whisper para transcricao final (qualidade/completude).
WHISPER_FINAL_MODEL=small

# Modelo Whisper para transcricao parcial ao vivo (latencia).
WHISPER_PARTIAL_MODEL=tiny

# Dispositivo de execucao Whisper (cpu|cuda).
WHISPER_DEVICE=cpu

# Tipo de computacao Whisper (int8|int8_float16|float16).
WHISPER_COMPUTE=int8

# Beam size do Whisper (maior tende a melhorar qualidade e aumentar custo/latencia).
WHISPER_BEAM_SIZE=5

# Sample rate solicitada para captura do microfone.
MIC_SAMPLE_RATE=16000

# Tamanho do bloco (frames) por leitura do microfone.
MIC_CHUNK_FRAMES=1024

# Tamanho maximo da janela de mensagens da conversa (usado no voice_cli).
CONVERSATION_MAX_MESSAGES=50

# ==========================================
# Variaveis legadas (compatibilidade)
# ==========================================

# Modelo generico legado de LLM (fallback quando OPENAI_MODEL/GEMINI_MODEL/OLLAMA_MODEL nao estiver definido).
LLM_MODEL=

# Janela de contexto legada (substituida por CONVERSATION_MAX_MESSAGES no fluxo atual de voz).
MAX_CONTEXT_MESSAGES=12

# Limiar STT legado (nao lido pelo codigo atual).
STT_CONFIDENCE_THRESHOLD=0.80

# Retries STT legado (nao lido pelo codigo atual).
STT_MAX_RETRIES_BELOW_THRESHOLD=2

# Meta de latencia STT p95 legada (referencia operacional).
STT_P95_MAX_SECONDS=2.5

# Meta de latencia ponta a ponta p95 legada (referencia operacional).
E2E_P95_MAX_SECONDS=4.0

# Limite legado de perguntas por ciclo (referencia de produto/perfil, nao lido por env no codigo atual).
MAX_QUESTIONS_PER_CYCLE=3
